# Copy this file to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pharma_complaints

# Comma-separated list is NOT supported directly; edit CORS_ORIGINS in app/config.py
# if you need more than the default http://localhost:3000

# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=gemma2-9b-it
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
